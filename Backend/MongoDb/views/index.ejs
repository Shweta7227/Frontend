<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ChitChat</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>
    <div class="header">
        <div class="heading"><h1>Welcome to ChitChat</h1></div>
        <div class="page"><h3>All Chats:</h3></div>
    </div>
    <form method="GET" action="/chats/new">
        <button>New Chat</button>
    </form>
    
    <div class="container">

        <% for(chat of chats){ %>
            <div class="chat">
                <p> From :<%= chat.from %> </p>
                <div class="msz">
                    <p class="message">
                        message : <%= chat.message %>
                    </p>
                </div>
                <p>To : <%=chat.to%></p>
                <div>
                         <form method="GET" action="/chats/<%=chat._id%>/edit">
                            <button>Edit</button>
                        </form>

                </div>
               <div>
                    <form method="POST" action="/chats/<%=chat._id%>?_method=DELETE">
                        <button>Delete</button>
                    </form>
               </div>
                
                <br>
                <div class="date">
                     <p><i><%=chat.created_at.toString().split(" ")[4]%></i></p>
                    <p><i><%=chat.created_at.toString().split(" ").slice(0,4).join(" ")%></i></p>
                </div>
               

            </div>
            <!-- <hr> -->
        <% } %>
    </ul>
</body>
</html>